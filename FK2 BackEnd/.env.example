DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/paskal_analytics
DEFAULT_MALL_ID=00000000-0000-0000-0000-000000000001
DEFAULT_MALL_NAME=23 Paskal Shopping Center
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI Provider ─────────────────────────────────────────────────────────────────
# Choose: "openai" | "anthropic" | "gemini"
# The engine will try the selected provider first, then fall back automatically.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Cache ───────────────────────────────────────────────────────────────────────
# Leave REDIS_URL empty to use the in-memory cache (single-instance deployments).
# Set to your Redis connection string to persist across restarts + scale horizontally.
REDIS_URL=
# redis://localhost:6379/0         ← example local Redis
# redis://:password@host:6379/0   ← example Redis with auth

# Insight cache TTL in seconds (default: 1 hour = 3600)
INSIGHT_CACHE_TTL_SECONDS=3600
